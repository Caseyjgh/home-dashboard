# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud OAuth 2.0 Web application credentials
CLIENT_ID=
SECRET=

# Optional canonical origin; set for the Pi Vercel Preview branch
AUTH_URL=

# Vercel KV REST credentials (server-side only)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# IANA time zone used to determine today's calendar boundaries
GOOGLE_CALENDAR_TIME_ZONE=

# City or postal code for the header forecast (Open-Meteo, no API key)
WEATHER_LOCATION=
