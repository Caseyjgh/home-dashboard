# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Durable calendar cache and server-side refresh cooldown
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IANA time zone used to determine today's calendar boundaries
GOOGLE_CALENDAR_TIME_ZONE=America/Denver
